{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reshi-diary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "AWS_REGION": "ap-northeast-1",
    "AWS_S3_BUCKET": "reshi-diary-files"
  },
  "secrets": {
    "required": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "GITHUB_TOKEN",
      "RESEND_API_KEY"
    ]
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reshi-diary-db",
      "database_id": "552881a1-f18c-4519-b659-7aa2cd648d8b"
    }
  ],
  "routes": [
    {
      "pattern": "rettheory.top/*",
      "zone_name": "rettheory.top"
    },
    {
      "pattern": "admin.rettheory.top/*",
      "zone_name": "rettheory.top"
    }
  ],
  "observability": {
    "enabled": true
  }
}
